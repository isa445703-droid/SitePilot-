# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/sitepilot?schema=public"

# --- AI (Mistral) ---
# Server-side only. Never exposed to the browser.
MISTRAL_API_KEY=""
# Model for heavy work. If your key rate-limits mistral-small/medium,
# switch to a model your key can use (open-mistral-nemo is verified working).
MISTRAL_MODEL="open-mistral-nemo"
# Optional cheaper/faster model for simple tasks (summaries, tags, SEO titles)
MISTRAL_MODEL_FAST="open-mistral-nemo"

# --- Auth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Scheduler / Cron ---
# Bearer token required by POST /api/cron
CRON_SECRET="change-me-to-a-long-random-string"

# --- Payments (Stripe-ready, not required for MVP) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Email (Resend) ---
RESEND_API_KEY=""

# --- Optional research provider (when empty, mock research mode is used in development) ---
SEARCH_PROVIDER=""
